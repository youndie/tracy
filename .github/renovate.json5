{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false` and its measured reason, the kotlin/kotlinx/sborka/ci-actions
  // groups and majors going to a human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: ci.yml runs on `pull_request`.
  //
  // `semanticCommits: "disabled"` is GONE rather than carried over. It said "commits here are prose,
  // not conventional commits", and that stopped being true: the last twenty commits on main are
  // `build(deps):`, `build(publish)!:` and the like. The sentence outlived its reason, so the preset's
  // `enabled` applies now and Renovate's own pull requests match the repository.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // The catalog's `ktlint` entry is the CLI version, read by build.gradle.kts through
  // libs.versions.ktlint.get(). No library or plugin references it, so the gradle
  // manager never sees it — without this it would stay at 1.8.0 forever.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^gradle/libs\\.versions\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+ktlint\\s*=\\s*\"(?<currentValue>.*?)\"",
      ],
    },
  ],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        // The plugin is named by its bare id, with nothing after it — a pattern that demands a
        // `:` or a `.` next matches the coordinate and misses the plugin entirely.
        "org.jlleitschuh.gradle.ktlint",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so the image never rides along with the wrapper. Both are called `gradle`
      // and move to the same version, so Renovate puts them in one PR — and one dep that may
      // not automerge holds back the whole PR. They are not the same risk: the wrapper is what
      // CI just ran, while no check on a pull request ever builds the Dockerfile.
      additionalBranchPrefix: "docker-",
    },
  ],
}
